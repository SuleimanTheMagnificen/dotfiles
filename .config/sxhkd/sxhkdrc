# Program launcher
#alt + o
#  rofi -show drun -show-icons

ctrl + shift + r
  rofi -icon-theme "Gruvbox Plus Dark" -show-icons -show

ctrl + shift + e
  rofi -show emoji

ctrl + shift + w
  rofi -show window

alt + m + {c,x,b,z,r,s}
  cmus-remote -{u,p,n,r,R,S}

alt + {k,l}
  cmus-remote -v {-1%,+1%}

alt + q
  copyq show Zwis\&chenablage

ctrl + shift + o
  alacritty
