configuration {
    modi:                       "drun,run,window,emoji";
    show-icons:                 true;
    display-drun:               "";
    display-run:                "";
    display-window:             "";
    display-emoji:             "";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t} · {e}";
}

@theme "ib"

// color pallete
* {
    font:                        "SpaceMono Nerd Font 12";
    background:                  #13121C;
    background-alt:              #19182180;
    foreground:                  #E7E2FF;
    selected:                    #9DA7FF;
    active:                      #FFA9E2;
    urgent:                      #FF6E84;
}

// theme image (image height is set via y-padding)
inputbar {
    background-image:            url("~/dotfiles/.config/rofi/images/planets.png", width);
    padding:                     75px 60px;
}
